<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!--
    Adds the local folder feed used during development of the KGSM ecosystem
    (/home/heisen/local-nuget), merged with the global sources (nuget.org,
    github) so their credentials are preserved.

    kgsm-lib consumes TheKrystalShip.KGSM.Firewall.Contracts from here — the wire
    contract for the kgsm-firewall authority that IFirewallService speaks. The
    dependency is one-directional: kgsm-lib depends on Firewall.Contracts, never
    the reverse (kgsm-firewall must not reference kgsm-lib — that would be a cycle).
  -->
  <packageSources>
    <add key="local-thekrystalship" value="/home/heisen/local-nuget" />
  </packageSources>
</configuration>
