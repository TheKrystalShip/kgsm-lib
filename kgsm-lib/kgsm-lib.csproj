    <RepositoryType>GitHub</RepositoryType>
    <Description>Classlibrary for KGSM Interop</Description>
    <PackageLicenseExpression>GPL-3.0-only</PackageLicenseExpression>
    <NeutralLanguage>en</NeutralLanguage>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <RootNamespace>TheKrystalShip.KGSM</RootNamespace>
    <AssemblyName>TheKrystalShip.KGSM</AssemblyName>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <DocumentationFile>bin\$(Configuration)\$(TargetFramework)\$(AssemblyName).xml</DocumentationFile>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
      <None Include="..\README.md" Pack="true" PackagePath="\"/>
  </ItemGroup>

  <!-- Expose internals (the test-only WatchdogClient(HttpClient) ctor) to the unit suite
       so the new console-follow/tail paths can be driven through a stub HttpMessageHandler
       without a live daemon socket. Compile-time only — no AOT/runtime impact. -->
  <ItemGroup>
    <InternalsVisibleTo Include="kgsm-lib.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.0" />
    <!-- The kgsm-firewall control-socket wire contract (DTOs + newline-JSON framing + source-gen
         context) that IFirewallService speaks. Resolved from the local-nuget folder feed (see
         ../nuget.config). One-directional: kgsm-lib depends on this, never the reverse — kgsm-firewall
         must not reference kgsm-lib (cycle). net10.0 + AOT/trim-clean, so it keeps kgsm-lib AOT-safe. -->
    <PackageReference Include="TheKrystalShip.KGSM.Firewall.Contracts" Version="1.1.0" />
  </ItemGroup>

</Project>
