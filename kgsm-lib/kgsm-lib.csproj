<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsAotCompatible>true</IsAotCompatible>

    <PackageId>TheKrystalShip.KGSM.Lib</PackageId>
    <Authors>Heisenberg</Authors>
    <Version>1.3.0</Version>
    <PackageReleaseNotes>1.3.0 — BREAKING: systemd removed as a KGSM instance lifecycle manager. Deleted the LifecycleManager enum and Instance.LifecycleManager/EnableSystemd/SystemdServiceFile/SystemdSocketFile/SystemdUnit, ConfigurationInfo.LifecycleManager, and the LifecycleManager field on the instance-started/stopped/restarted event payloads. Instance.Runtime (native|container) is now the sole supervision discriminator. Legacy lifecycle_manager/systemd_* JSON fields older KGSM still emits are tolerated (unmapped, ignored). — 1.2.0: Typed kgsm-watchdog control client (IWatchdogClient / WatchdogClient): start/stop/status/list/ready over the daemon's unix socket (HTTP/1.1 via SocketsHttpHandler.ConnectCallback), reflection-free source-generated JSON (Native AOT/trim-safe), registered via AddKgsmWatchdogClient. — 1.1.0: Bulk fleet status read (GetAllStatuses, with --fast); restart and *-failed event types; reflection-free source-generated JSON for Native AOT/trim safety.</PackageReleaseNotes>
    <PackageProjectUrl>https://github.com/TheKrystalShip/KGSM-Lib</PackageProjectUrl>
    <RepositoryUrl>https://github.com/TheKrystalShip/KGSM-Lib</RepositoryUrl>
    <RepositoryType>GitHub</RepositoryType>
    <Description>Classlibrary for KGSM Interop</Description>
    <PackageLicenseExpression>GPL-3.0-only</PackageLicenseExpression>
    <NeutralLanguage>en</NeutralLanguage>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <RootNamespace>TheKrystalShip.KGSM</RootNamespace>
    <AssemblyName>TheKrystalShip.KGSM</AssemblyName>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <DocumentationFile>bin\$(Configuration)\$(TargetFramework)\$(AssemblyName).xml</DocumentationFile>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
      <None Include="..\README.md" Pack="true" PackagePath="\"/>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="9.0.0" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="9.0.0" />
  </ItemGroup>

</Project>
