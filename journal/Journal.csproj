<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsAotCompatible>true</IsAotCompatible>

    <PackageId>TheKrystalShip.KGSM.Journal</PackageId>
    <Authors>Heisenberg</Authors>
    <Version>2.1.0</Version>
    <PackageProjectUrl>https://github.com/TheKrystalShip/KGSM-Lib</PackageProjectUrl>
    <RepositoryUrl>https://github.com/TheKrystalShip/KGSM-Lib</RepositoryUrl>
    <RepositoryType>GitHub</RepositoryType>
    <Description>Appends events to a KGSM producer&apos;s own append-only event journal — the envelope, its write half, and the conformance rules a reader checks it against.</Description>
    <PackageLicenseExpression>GPL-3.0-or-later</PackageLicenseExpression>
    <NeutralLanguage>en</NeutralLanguage>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>

    <!-- The namespaces are DELIBERATELY the ones these types already lived under in kgsm-lib. A type
         does not care which assembly its namespace comes from, so every existing consumer compiles
         unchanged — moving the writer out cost nobody a `using` edit. -->
    <RootNamespace>TheKrystalShip.KGSM</RootNamespace>
    <AssemblyName>TheKrystalShip.KGSM.Journal</AssemblyName>
    <DocumentationFile>bin\$(Configuration)\$(TargetFramework)\$(AssemblyName).xml</DocumentationFile>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <!-- The whole dependency surface. A producer that records what it did needs a logger, a way to be
         registered, and the BCL; anything more would be the engine-interop library arriving through the
         back door, which is the entire reason this is a separate package.

         ⚠ Both are the Abstractions packages, and that is the constraint, not an accident. The
         DependencyInjection *implementation* would bring a container this package never builds, and
         Hosting would bring a process model — into a root-running firewall authority whose attack
         surface is the reason the writer lives here at all. A registration helper is worth one
         interface; it is not worth a host. -->
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.0" />
  </ItemGroup>

</Project>
